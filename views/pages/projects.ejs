<!DOCTYPE html>
<html lang="fr">

<head>
  <%- include('../partials/head', { title, description, url }) %>
</head>

<body>

   <%- include('../partials/header', { page }) %>

    <main>

        <!-- HERO SECTION -->
        <section class="projects-hero">

            <div class="projects-hero-content">

                <span class="section-tag">NOS RÉALISATIONS</span>

                <h1>
                    Des idées transformées en
                    <span>innovations intelligentes.</span>
                </h1>

                <p>
                    Nous explorons les possibilités offertes par les nouvelles
                    technologies pour concevoir des solutions intelligentes,
                    innovantes et adaptées aux défis de demain.
                </p>

                <a href="#project-gallery" class="projects-hero-button">
                    Explorer nos projets <span>↗</span>
                </a>

            </div>

        </section>


        <!-- INTRODUCTION -->
        <section class="projects-introduction">

            <div class="container">

                <span class="section-tag">INNOVATION & TECHNOLOGIE</span>

                <h2>
                    La technologie au service
                    <span>des idées.</span>
                </h2>

                <p>
                    Chaque projet représente une opportunité d'explorer,
                    d'expérimenter et de repousser les limites de la technologie.
                    De la conception algorithmique au développement de solutions
                    intelligentes, nous transformons les défis complexes en
                    opportunités d'innovation.
                </p>

            </div>

        </section>


        <!-- PROJECT FILTERS -->
        <section class="projects-gallery-section" id="project-gallery">

            <div class="container">

                <div class="projects-section-heading">

                    <div>
                        <span class="section-tag">NOTRE PORTFOLIO</span>
                        <h2>Explorer nos projets</h2>
                    </div>

                    <p>
                        Découvrez nos domaines d'exploration et nos solutions
                        technologiques.
                    </p>

                </div>


                <!-- Filtres visuels : fonctionnalité à ajouter ensuite -->
                <div class="project-filters">

                    <button class="project-filter active" data-filter="all">
                        Tous les projets
                    </button>

                    <button class="project-filter" data-filter="computer-vision">
                        Computer Vision
                    </button>

                    <button class="project-filter" data-filter="artificial-intelligence">
                        Intelligence artificielle
                    </button>

                    <button class="project-filter" data-filter="data-science">
                        Data Science
                    </button>

                    <button class="project-filter" data-filter="automation">
                        Automatisation
                    </button>

                </div>


                <!-- PROJECT GRID -->
                <div class="projects-showcase-grid">


                    <!-- PROJECT 01 -->
                    <article class="showcase-card"
                        data-category="computer-vision">

                        <div class="showcase-image">
                            <img src="/images/project-computer-vision.jpg"
                                alt="Projet de détection intelligente d'objets">

                            <span class="showcase-category">
                                COMPUTER VISION
                            </span>
                        </div>

                        <div class="showcase-content">

                            <span class="showcase-number">01 / VISION</span>

                            <h3>Intelligent Object Detection</h3>

                            <p>
                                Exploration de systèmes capables de détecter,
                                reconnaître et localiser automatiquement des
                                objets dans des images et des vidéos.
                            </p>

                            <a href="/projects/computer-vision" class="showcase-link">
                                Découvrir le projet <span>↗</span>
                            </a>

                        </div>

                    </article>


                    <!-- PROJECT 02 -->
                    <article class="showcase-card"
                        data-category="artificial-intelligence">

                        <div class="showcase-image">
                            <img src="/images/project-sports-ai.jpg"
                                alt="Analyse intelligente des événements sportifs">

                           