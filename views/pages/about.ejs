<!DOCTYPE html>
<html lang="fr">

<head>
  <%- include('../partials/head', { title, description, url }) %>
</head>

<body>

    <!-- HEADER -->
   <%- include('../partials/header', { page }) %>

    <main>

        <!-- CONTENU DE LA PAGE ABOUT -->
               <!-- HERO ABOUT -->
        <section class="about-hero">
            <div class="container">

                <span class="section-tag">À PROPOS DE SYNAPSEDYNAMICS</span>

                <h1>
                    L'intelligence artificielle<br>
                    au cœur de <span>l'innovation.</span>
                </h1>

                <p>
                    Nous sommes une entreprise technologique tournée vers
                    l'avenir, spécialisée dans la conception de solutions
                    intelligentes et le développement de nouvelles
                    technologies d'intelligence artificielle.
                </p>

            </div>
        </section>


        <!-- PRESENTATION DE L'ENTREPRISE -->
        <section class="about-introduction">
            <div class="container about-intro-grid">

                <div class="about-intro-text">

                    <span class="section-tag">QUI SOMMES-NOUS ?</span>

                    <h2>
                        Transformer les idées en
                        <span>intelligence.</span>
                    </h2>

                    <p>
                        SynapseDynamics est une entreprise technologique
                        spécialisée dans l'intelligence artificielle,
                        l'ingénierie logicielle et l'innovation numérique.
                    </p>

                    <p>
                        Nous accompagnons les organisations dans la conception
                        et le déploiement de solutions technologiques capables
                        de répondre à des problématiques concrètes.
                    </p>

                    <p>
                        Au-delà des prestations technologiques, nous développons
                        également une activité de recherche et développement
                        destinée à explorer de nouvelles approches, expérimenter
                        des modèles et construire nos propres technologies.
                    </p>

                </div>

                <div class="about-intro-visual">

                    <div class="about-visual-box">

                        <div class="about-orbit orbit-one"></div>
                        <div class="about-orbit orbit-two"></div>

                        <div class="about-core">
                            <span>SD</span>
                        </div>

                        <div class="about-visual-caption">
                            <span>RESEARCH</span>
                            <span>INNOVATION</span>
                            <span>INTELLIGENCE</span>
                        </div>

                    </div>

                </div>

            </div>
        </section>


        <!-- VISION ET MISSION -->
        <section class="about-purpose">
            <div class="container">

                <div class="section-heading">
                    <span class="section-tag">NOTRE RAISON D'ÊTRE</span>

                    <h2>
                        Une vision tournée<br>
                        vers le futur.
                    </h2>

                    <p>
                        Notre ambition est de contribuer à construire
                        un avenir dans lequel la technologie améliore
                        concrètement les capacités humaines et organisationnelles.
                    </p>
                </div>

                <div class="purpose-grid">

                    <article class="purpose-card">

                        <span class="purpose-number">01</span>

                        <div class="purpose-icon">◎</div>

                        <h3>Notre vision</h3>

                        <p>
                            Devenir un acteur technologique reconnu dans
                            la conception, la recherche et le développement
                            de technologies d'intelligence artificielle
                            innovantes et accessibles.
                        </p>

                    </article>

                    <article class="purpose-card">

                        <span class="purpose-number">02</span>

                        <div class="purpose-icon">↗</div>

                        <h3>Notre mission</h3>

                        <p>
                            Concevoir des solutions intelligentes,
                            accompagner la transformation numérique
                            et développer des technologies capables
                            de résoudre des défis réels.
                        </p>

                    </article>

                </div>

            </div>
        </section>


        <!-- NOS VALEURS -->
        <section class="about-values">
            <div class="container">

                <div class="section-heading">
                    <span class="section-tag">NOS PRINCIPES</span>

                    <h2>
                        Les valeurs qui<br>
                        guident notre travail.
                    </h2>
                </div>

                <div class="values-grid">

                    <article class="value-card">
                        <span class="value-icon">01</span>
                        <h3>Innovation</h3>
                        <p>
                            Explorer de nouvelles idées et repousser
                            les limites de la technologie.
                        </p>
                    </article>

                    <article class="value-card">
                        <span class="value-icon">02</span>
                        <h3>Excellence</h3>
                        <p>
                            Rechercher la qualité, la précision
                            et la performance dans chaque réalisation.
                        </p>
                    </article>

                    <article class="value-card">
                        <span class="value-icon">03</span>
                        <h3>Recherche</h3>
                        <p>
                            Expérimenter, apprendre et développer
                            continuellement de nouvelles connaissances.
                        </p>
                    </article>

                    <article class="value-card">
                        <span class="value-icon">04</span>
                        <h3>Impact</h3>
                        <p>
                            Mettre la technologie au service
                            de problématiques concrètes.
                        </p>
                    </article>

                </div>

            </div>
        </section>

    </main>

    <!-- FOOTER -->
    <%- include('../partials/footer') %>

</body>
</html>